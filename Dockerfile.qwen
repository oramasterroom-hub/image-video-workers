# Qwen-Image-2512 (GGUF Q8_0) 런포드 서버리스 워커
#
# 모델 가중치는 이 이미지에 넣지 않는다. 워커가 뜰 때 허깅페이스에서 직접 받는다.
# ⚠️ 런포드 모델 캐싱을 쓰지 않는 이유: 저장소를 통째로 받는 방식인데
#    GGUF 저장소는 양자화 15종이 들어 있어 256GB 다. 우리가 쓸 건 21.76GB 파일 하나뿐이다.

# ⚠️ CUDA 13 판이어야 한다 (2026-08-02 실제로 당함).
#    24GB 를 고르면 RTX PRO 6000 Blackwell MIG 조각이 배정될 수 있는데,
#    CUDA 12 판 파이토치는 그 GPU(sm_120)를 몰라서 워커가 즉사한다.
FROM pytorch/pytorch:2.13.0-cuda13.0-cudnn9-runtime

# ⚠️ HF_HUB_OFFLINE 을 켜지 않는다. 이전 워커들과 다른 점이다.
#    이전에는 런포드 캐시에서 읽기만 해서 오프라인이 맞았지만, 여기서는 직접 받아야 한다.
ENV PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HUB_ENABLE_HF_TRANSFER=1

WORKDIR /app

# ⚠️ pip 업그레이드 줄을 넣지 말 것. 우분투가 깐 pip 는 pip 가 못 지워서 빌드가 통째로 실패한다.
# ⚠️ `pip` 가 아니라 `python -m pip` 를 쓴다. 실행할 파이썬과 설치할 파이썬을 일치시키기 위해서다.
# ⚠️ --break-system-packages 를 빼면 externally-managed-environment 로 거부당한다.
#
# diffusers 0.39.0 에 QwenImagePipeline / QwenImageTransformer2DModel 이 정식 포함돼 있다.
# 공식 README 는 깃허브 개발판을 받으라고 하지만 그건 출시 당시(2025-12) 안내이고,
# 0.39.0(2026-07-03 릴리스)에 들어 있는 것을 확인했다. 버전을 고정할 수 있어야 안전하다.
#
# gguf        GGUF 파일을 읽는 데 필요
# hf_transfer 38.6GB 를 빨리 받기 위해 필요
# peft        ⭐ LoRA 를 얹는 데 필요 (2026-08-04 v4 에서 이게 없어서 워커가 죽었다)
#             diffusers 의 load_lora_weights() 는 첫 줄에서 USE_PEFT_BACKEND 를 확인하고
#             없으면 ValueError("PEFT backend is required for this method.") 로 거부한다.
#             GGUF 에 LoRA 가 붙는지는 소스로 확인해놓고 정작 이 패키지를 안 넣었다.
RUN python -m pip install --no-cache-dir --break-system-packages \
      diffusers==0.39.0 \
      "transformers>=4.51" \
      accelerate \
      safetensors \
      sentencepiece \
      protobuf \
      pillow \
      gguf \
      hf_transfer \
      runpod \
      peft

# ⭐ 빌드 시점에 검증한다. 문제가 있으면 워커를 띄우기 전에 여기서 걸린다.
RUN python -c "import sys; print('python:', sys.executable)" && \
    python -c "import torch; print('torch:', torch.__version__, 'cuda build:', torch.version.cuda)" && \
    python -c "import torch; a=torch.cuda.get_arch_list(); print('arch list:', a); assert any('120' in x for x in a), 'sm_120(블랙웰) 미지원 파이토치다'" && \
    python -c "from diffusers import QwenImagePipeline, QwenImageTransformer2DModel, GGUFQuantizationConfig; print('QwenImage + GGUF import OK')" && \
    python -c "import peft; print('peft:', peft.__version__)" && \
    python -c "from diffusers.utils import USE_PEFT_BACKEND; print('USE_PEFT_BACKEND =', USE_PEFT_BACKEND); assert USE_PEFT_BACKEND, 'peft 백엔드가 꺼져 있다. load_lora_weights 가 거부한다'" && \
    python -c "import gguf, hf_transfer; print('gguf/hf_transfer OK')" && \
    python -c "import runpod, transformers, accelerate; print('runpod/transformers/accelerate OK')"

COPY handler_qwen.py /app/handler_qwen.py

# ⭐ handler 문법 검사. 이 PC 에는 파이썬이 없어서 로컬에서 못 돌린다.
#    여기서 걸리면 워커를 띄우기 전에 빌드가 실패하므로 요금이 안 나간다.
RUN python -m py_compile /app/handler_qwen.py && echo "handler 문법 OK"

CMD ["python", "-u", "handler_qwen.py"]
