# Krea 2 Raw + Turbo LoRA — ComfyUI 런포드 서버리스 워커
#
# 모델 가중치는 이 이미지에 넣지 않는다. 워커가 뜰 때 허깅페이스에서 직접 받는다.
# (실측: 초당 800MB. 도커에 구우면 handler 한 줄 고칠 때마다 수십 GB 재빌드를 해야 한다)
#
# ⚠️ 런포드 콘솔의 Model(모델 캐싱) 칸은 반드시 비워둔다. 저장소를 통째로 받는 방식이다.

# ──────────────────────────────────────────────────────────────────────
# ⚠️ 왜 런포드 공식 worker-comfyui 완성 이미지를 안 쓰는가
#
#   runpod/worker-comfyui:5.8.6-base 는 2026-06-17 에 빌드됐는데
#   Krea 2 는 2026-06-22 출시다. 그 이미지 안의 ComfyUI 에는 Krea2 지원이 없다.
#   게다가 공식 Dockerfile 기본값이 `ARG COMFYUI_VERSION=latest` 라
#   완성 이미지로는 버전 고정 자체가 불가능하다.
#   → ComfyUI 를 우리가 태그로 직접 받는다. 구조는 worker-comfyui 를 참고했다.
# ──────────────────────────────────────────────────────────────────────

# ⚠️ CUDA 12.8 판이어야 한다 (Qwen 워커에서 2026-08-02 실제로 당한 문제).
#    24GB 를 고르면 RTX PRO 6000 Blackwell 의 MIG 조각(sm_120)이 배정될 수 있는데
#    cu126 파이토치에는 sm_120 커널이 없어서 워커가 즉사한다.
#    콘솔에서 MIG 를 배제하면 안 만나지만, 체크 하나에 목숨을 걸 이유가 없다.
#    cu128 은 블랙웰 지원을 위해 나온 빌드라 구형 GPU 와 sm_120 을 모두 덮는다.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# ⭐ 전부 고정한다. latest·브랜치 추적 금지 (보스 지시 2026-08-04).
#    latest 로 두면 빌드할 때마다 다른 게 깔려서 오늘 되던 게 내일 깨진다.
ARG COMFYUI_VERSION=v0.29.2
ARG COMFYUI_GGUF_COMMIT=80b7ab622b68894de8bf533bfa730a16b58d62b9
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_PREFER_BINARY=1 \
    PIP_NO_INPUT=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    COMFYUI_PORT=8188

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 \
      python3.12-venv \
      git \
      wget \
      ca-certificates \
      libgl1 \
      libglib2.0-0 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# uv 로 격리된 venv 를 만든다. 우분투가 관리하는 파이썬을 건드리지 않기 위해서다.
# (Qwen 워커에서는 --break-system-packages 로 우회했는데, venv 가 더 깔끔하다)
RUN wget -qO- https://astral.sh/uv/install.sh | sh \
    && ln -s /root/.local/bin/uv /usr/local/bin/uv \
    && uv venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# ⭐ 파이토치를 먼저 cu128 로 깐다.
#    ComfyUI requirements.txt 의 `torch` 는 버전이 안 적혀 있어서,
#    먼저 깔아두면 그 단계에서 건드리지 않고 넘어간다.
RUN uv pip install --index-url ${TORCH_INDEX_URL} torch torchvision torchaudio

# ComfyUI 본체 — 태그로 고정해서 받는다
RUN git clone --depth 1 --branch ${COMFYUI_VERSION} \
      https://github.com/comfyanonymous/ComfyUI /comfyui

# ⚠️ transformers / huggingface-hub 를 같은 단계에서 못박는다.
#    ComfyUI 는 상한을 안 걸어놔서 새로 깔면 5.x / 1.x 가 딸려와 시작할 때 죽는다.
#    (런포드 공식 Dockerfile 에도 같은 주석과 같은 핀이 달려 있다)
RUN uv pip install -r /comfyui/requirements.txt \
    && uv pip install "transformers>=4.50.3,<5" "huggingface-hub<1.0"

# handler 가 쓰는 것 + GGUF 폴백용
#   runpod       서버리스 진입점
#   requests     ComfyUI HTTP API 호출
#   hf_transfer  대용량 다운로드 가속 (초당 800MB 의 정체)
#   gguf         molbal 노드가 요구
RUN uv pip install runpod requests hf_transfer "gguf>=0.13.0"

# ──────────────────────────────────────────────────────────────────────
# GGUF 커스텀 노드 — 폴백 전용. 1안(fp8_scaled)에서는 쓰지 않는다.
#
# ⚠️ 표준인 city96/ComfyUI-GGUF 는 Krea2 를 지원하지 않는다.
#    2026-01-12 이후 7개월째 방치돼 있고 소스에 krea 가 0건이다.
#    molbal 포크의 loader.py IMG_ARCH_LIST 에 "krea2" 가 들어 있는 것을 확인하고 골랐다.
#
# ⚠️ molbal README 원문: "LoRA loading is experimental."
#    그래서 이걸 1안에서 뺐다. 안 쓰면 이미지에 있어도 아무 영향이 없고,
#    폴백으로 갈아탈 때 재빌드 없이 워크플로만 바꾸면 된다.
# ──────────────────────────────────────────────────────────────────────
RUN git clone https://github.com/molbal/ComfyUI-GGUF \
      /comfyui/custom_nodes/ComfyUI-GGUF \
    && git -C /comfyui/custom_nodes/ComfyUI-GGUF checkout ${COMFYUI_GGUF_COMMIT} \
    && git -C /comfyui/custom_nodes/ComfyUI-GGUF rev-parse HEAD

# 모델이 들어갈 폴더를 미리 만든다. handler 가 여기에 받아 놓는다.
RUN mkdir -p /comfyui/models/diffusion_models \
             /comfyui/models/text_encoders \
             /comfyui/models/vae \
             /comfyui/models/loras \
             /comfyui/models/unet

# ⭐ 빌드 시점 검증. 문제가 있으면 워커를 띄우기 전에 여기서 걸린다 = 요금이 안 나간다.
RUN python -c "import sys; print('python:', sys.executable)" \
 && python -c "import torch; print('torch:', torch.__version__, 'cuda build:', torch.version.cuda)" \
 && python -c "import torch; a=torch.cuda.get_arch_list(); print('arch list:', a); assert any('120' in x for x in a), 'sm_120(블랙웰) 커널이 없는 파이토치다'" \
 && python -c "import runpod, requests, hf_transfer, gguf; print('runpod/requests/hf_transfer/gguf OK')" \
 && python -c "from huggingface_hub import hf_hub_download; print('huggingface_hub OK')"

# ⭐ ComfyUI 를 실제로 한 번 띄워본다(CPU). 노드 그래프를 전부 import 하므로
#    커스텀 노드가 깨졌거나 의존성이 어긋났으면 여기서 잡힌다.
#    런타임에 "server not reachable" 로 나타나면 원인을 못 찾는다.
# ⭐ 그리고 Krea2 지원이 이 ComfyUI 판에 실제로 들어 있는지 확인한다.
RUN cd /comfyui && timeout 600 python main.py --quick-test-for-ci --cpu \
 && python -c "\
import sys; sys.path.insert(0, '/comfyui'); \
import comfy.sd as s; \
assert hasattr(s.CLIPType, 'KREA2'), 'CLIPType.KREA2 가 없다'; \
print('CLIPType.KREA2 =', int(s.CLIPType.KREA2))"

COPY handler_krea2.py /handler_krea2.py

# ⭐ handler 문법 검사. 이 PC 에는 파이썬이 없어서 로컬에서 못 돌린다.
RUN python -m py_compile /handler_krea2.py && echo "handler 문법 OK"

CMD ["python", "-u", "/handler_krea2.py"]
